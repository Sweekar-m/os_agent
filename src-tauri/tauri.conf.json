{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "os-agent",
  "version": "0.1.0",
  "identifier": "com.osagent.desktop",
  "build": {
    "frontendDist": "../desktop_app"
  },
  "app": {
    "windows": [
      {
        "title": "OS Agent - ChatGPT Desktop",
        "width": 1240,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
